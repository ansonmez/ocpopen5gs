FROM node:18-alpine

LABEL maintainer="asonmez"
LABEL org.opencontainers.image.title="open5gs-webui"
LABEL org.opencontainers.image.version="v2.8.0"

ENV OPEN5GS_VERSION=v2.8.0
ENV NODE_ENV=production

RUN apk add --no-cache git python3 make g++ && \
    git clone --depth 1 -b ${OPEN5GS_VERSION} https://github.com/open5gs/open5gs.git

WORKDIR /open5gs/webui

RUN npm install && npm run build

EXPOSE 3000

CMD ["npm", "run", "start"]
